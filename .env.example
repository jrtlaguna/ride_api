# Copy to .env and fill in real values:  cp .env.example .env

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Wrap in single quotes -- generated keys contain # and $.
SECRET_KEY='change-me'

# Never True in a deployed environment.
DEBUG=False

# Seed admin (accounts.0002_seed_users). Unset the password to skip creating it.
# Use a real password outside local development.
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=change-me

# Postgres credentials. A future docker-compose `db` service reads these
# directly (POSTGRES_* are the names the official postgres image expects), so
# keep them consistent with DATABASE_URL below.
POSTGRES_DB=ride_api
POSTGRES_USER=ride_api
POSTGRES_PASSWORD=change-me

# Host runs use localhost:
#   postgres://ride_api:change-me@localhost:5432/ride_api
# Under Compose, point at the `db` service name instead:
#   postgres://ride_api:change-me@db:5432/ride_api
DATABASE_URL=postgres://ride_api:change-me@localhost:5432/ride_api

# Optional. Seconds to hold a database connection open (0 disables reuse).
# PAGE_SIZE and CONN_MAX_AGE both fall back to code defaults if unset.
# CONN_MAX_AGE=60
# PAGE_SIZE=20
